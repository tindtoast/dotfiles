# .bashrc

# if not running interactively, do nothing
[[ -n $PS1 ]] || return

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# General Aliases
alias chez=chezmoi
alias py=python
alias tracert=traceroute
alias vim=nvim # boohoo

# Extra Aliases
alias reboot='systemctl reboot'

colors() {
    for i in {0..255}; do
        printf '\e[48;5;%dm%3d ' "$i" "$i"
        (((i+3) % 18)) || printf '\e[0m\n'
    done
    printf '\e[0m\n'
}

ctest() {
	local text="$*"
	if (($# < 2)); then
		echo "Usage: ctest [RGB Color] [text]"
	else
		printf '\e[38;5;%im%s\e[0m\n' "$1" "${text#* }"
	fi
}

# might as well make place this here
ezbashrc() {
	local bashrc="$HOME/.bashrc"
	cat "$bashrc" > "$bashrc".tmp
	run0edit --no-prompt "$bashrc"
	if ! diff "$bashrc" "$bashrc".tmp >/dev/null 2>&1; then
		echo "Applying changes to chezmoi..."
		chezmoi add "$bashrc"
	fi
}

hist() {
	if (($# == 0)); then
        echo "what are you trying to look for?"
    else
        history | grep -i "$1"
    fi
}

mans() {
	if (($# != 2)); then
        echo "Usage: mans [command] [query]"
    else
        man "$1" | grep -iC 5 "$2"
    fi
}

mkcd() {
    mkdir -p "$1" && cd "$1"
}
